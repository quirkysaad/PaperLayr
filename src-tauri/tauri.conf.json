{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperLayr",
  "version": "0.1.0",
  "identifier": "com.saadpatel.paperlayr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperLayr",
        "width": 800,
        "height": 600,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4NkE4RTIzNERENUQ5MApSV1NRWGQwMDRxaUdDbUhlRzd6bHVqN0pQWTNSTFF1UGNBaWdKSjBhaWxLQllzOXNEUS81MmpNUQo=",
      "endpoints": [
        "https://github.com/quirkysaad/PaperLayr/releases/latest/download/latest.json"
      ]
    }
  }
}